# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Any LiteLLM model string "<provider>/<model>". Rate-limited models fall back in order.
SRE_MODEL=gemini/gemini-3.5-flash
SRE_FALLBACK_MODELS=gemini/gemini-flash-latest,gemini/gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite,openrouter/nvidia/nemotron-3-super-120b-a12b:free,groq/openai/gpt-oss-120b

# Google Cloud models (Vertex AI) instead of an AI Studio key: SRE_MODEL=vertex_ai/gemini-3.5-flash
# On a Compute Engine VM the VM's service account is used. Elsewhere: gcloud auth application-default login
# VERTEXAI_PROJECT=my-gcp-project
# VERTEXAI_LOCATION=europe-west1

# Telemetry endpoints (defaults match infra/sre/demo.sh)
# SRE_PROMETHEUS_URL=http://127.0.0.1:9090
# SRE_JAEGER_URL=http://127.0.0.1:16686/jaeger/ui
# SRE_OPENSEARCH_URL=http://127.0.0.1:9200
# SRE_DOCKER_SOCKET=/var/run/docker.sock
# SRE_VERIFY_WAIT_SECONDS=75

# CrewAI review board over A2A (uv run sre-triage reviewer --port 8002). Without it the local critic reviews.
# SRE_REVIEWER_A2A_URL=http://127.0.0.1:8002

# MCP tool servers (uv run sre-triage mcp --port 8011). Without it they start inside the app process.
# SRE_MCP_URL=http://127.0.0.1:8011

# Langfuse tracing (https://cloud.langfuse.com -> project settings -> API keys). Without keys nothing is exported.
# The Langfuse SDK reads these itself. US cloud: https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development   # keeps test traces apart from the deployed app's

# Behaviour switches
# SRE_MEMORY=on                 # off: no recall and no learning
# SRE_MAX_ROUNDS=3              # investigation rounds the coordinator may dispatch
# SRE_SCREEN_WITH_LLM=on        # second-stage LLM check of operator input (the regex screen always runs)
