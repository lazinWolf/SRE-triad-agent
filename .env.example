# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Any LiteLLM model string "<provider>/<model>". Rate-limited models fall back in order.
SRE_MODEL=gemini/gemini-3.5-flash
SRE_FALLBACK_MODELS=gemini/gemini-flash-latest,gemini/gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite,openrouter/nvidia/nemotron-3-super-120b-a12b:free,groq/openai/gpt-oss-120b

# Telemetry endpoints (defaults match infra/sre/demo.sh)
# SRE_PROMETHEUS_URL=http://127.0.0.1:9090
# SRE_JAEGER_URL=http://127.0.0.1:16686/jaeger/ui
# SRE_OPENSEARCH_URL=http://127.0.0.1:9200
# SRE_DOCKER_SOCKET=/var/run/docker.sock
# SRE_VERIFY_WAIT_SECONDS=75

# Review reports with the Critic A2A service (uv run sre-triage a2a-critic --port 8001)
# SRE_CRITIC_A2A_URL=http://127.0.0.1:8001
