# Copy to .env and fill in. Never commit .env.

# Models are LiteLLM strings "<provider>/<model>". Test them with: uv run sre-triage models --probe
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
SRE_MODEL=gemini/gemini-3.5-flash
# Each model has its own free-tier quota; exhausted models are skipped automatically.
SRE_FALLBACK_MODELS=gemini/gemini-flash-latest,gemini/gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite,gemini/gemma-4-31b-it,openrouter/nvidia/nemotron-3-super-120b-a12b:free,groq/openai/gpt-oss-120b
# Optional per-role overrides
SRE_COORDINATOR_MODEL=
SRE_SPECIALIST_MODEL=
SRE_MODEL_RETRIES=4
SRE_MODEL_TEMPERATURE=0.1

# Investigation budgets (shared by multi-agent and single-agent modes)
SRE_MAX_TOOL_CALLS=40
SRE_MAX_LLM_CALLS=40
SRE_MAX_ROUNDS=3
SRE_WALL_SECONDS=420

# Open and investigate alert cases automatically when the worker runs (needs SRE_MODEL)
SRE_AUTO_INVESTIGATE=1

# Telemetry endpoints (defaults match infra/sre/demo.sh on this machine)
SRE_PROMETHEUS_URL=http://127.0.0.1:9090
SRE_JAEGER_URL=http://127.0.0.1:16686/jaeger/ui
SRE_OPENSEARCH_URL=http://127.0.0.1:9200
SRE_DOCKER_URL=unix:///var/run/docker.sock
SRE_DATA_DIR=data
